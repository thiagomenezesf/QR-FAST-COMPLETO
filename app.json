{
  "expo": {
    "name": "checkin-qr",
    "slug": "checkin-qr",
    "scheme": "qr-fast-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b360b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seuusuario.checkinqr",
      "infoPlist": {
      "NSCameraUsageDescription": "Este aplicativo precisa da câmera para escanear os QR Codes dos ingressos."
      }
    },
    "android": {
      "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff",
      "package": "com.seuusuario.checkinqr",
      "permissions": ["CAMERA"]
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "display": "standalone",
      "lang": "pt-BR",
      "backgroundColor": "#ffffff",
      "themeColor": "#276818",
      "description": "Sistema de Check-in via QR Code",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "1194ec15-ec91-4016-a620-d6430af0daa9"
      }
    }
  }
}
